def alphabeta(node, depth, alpha, beta, maximizing):
    if depth == 2:
        return tree[node]
    if maximizing:
        value = float("-inf")
        for child in [2 * node + 1, 2 * node + 2]:
            value = max(value, alphabeta(child, depth + 1, alpha, beta, False))
            alpha = max(alpha, value)
            if alpha >= beta:
                break
        return value
    value = float("inf")
    for child in [2 * node + 1, 2 * node + 2]:
        value = min(value, alphabeta(child, depth + 1, alpha, beta, True))
        beta = min(beta, value)
        if alpha >= beta:
            break
    return value
tree = [0, 0, 0, 3, 5, 2, 9]
print("Best value:", alphabeta(0, 0, float("-inf"), float("inf"), True))
