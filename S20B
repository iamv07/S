import pandas as pd
df = pd.DataFrame({"Name": ["Amit", "Riya", "Amit", "Raj"], "Age": [20, 21, 20, None]})
print("Missing values:")
print(df.isnull().sum())
print("Duplicate rows:", df.duplicated().sum())
df = df.drop_duplicates()
df = df.dropna()
df.to_csv("cleaned_data.csv", index=False)
print("Cleaned dataset:")
print(df)
